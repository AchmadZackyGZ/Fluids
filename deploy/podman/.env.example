# ==========================================
# FLUIDS INFRASTRUCTURE (PODMAN) ENV TEMPLATE
# Dibaca oleh: deploy/podman/podman-compose.dev.yml
#
# Cara pakai:
#   cp deploy/podman/.env.example deploy/podman/.env
#
# Catatan: podman-compose membaca `.env` dari folder yang sama
# dengan file compose-nya, jadi file ini WAJIB ada di deploy/podman/.
# ==========================================

# --- PostgreSQL (pgvector/pgvector:pg16) ---
POSTGRES_USER=fluids_admin
POSTGRES_PASSWORD=fluids_password
POSTGRES_DB=fluids_db
POSTGRES_HOST_PORT=5436
POSTGRES_CONTAINER_PORT=5432

# --- Redis (redis:7-alpine) ---
REDIS_HOST_PORT=6379

# --- RabbitMQ (rabbitmq:3-management-alpine) ---
RABBITMQ_DEFAULT_USER=fluids_rabbitmq
RABBITMQ_DEFAULT_PASS=fluids_rabbitmq_password
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Kafka (apache/kafka:latest) ---
KAFKA_HOST_PORT=9092

# --- MinIO (minio/minio:latest) ---
MINIO_ROOT_USER=fluids_minio
MINIO_ROOT_PASSWORD=fluids_minio_password
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
